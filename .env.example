# Use deterministic checked-in fixtures (recommended for local development).
KNOWNGATE_MOCK=1

# For live mode, unset KNOWNGATE_MOCK (or set KNOWNGATE_MOCK=0) and set the
# KnownGate API base that already includes /v0 (or equivalent).
# Same-origin /api/knowngate/v0/* is a wildcard proxy onto it — method, headers,
# and body are forwarded intact; MCP/SSE responses are streamed (not buffered).
# Example: POST /api/knowngate/v0/check_item → POST {BASE}/check_item
# KNOWNGATE_MOCK=0
# KNOWNGATE_API_BASE=https://api.example.com/v0
